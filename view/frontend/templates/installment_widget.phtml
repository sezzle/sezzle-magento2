<?php
use Magento\Framework\View\Helper\SecureHtmlRenderer;
use Sezzle\Sezzlepay\Block\Widget\Installment;

/**  @var SecureHtmlRenderer $secureRenderer */
/**  @var Installment $block */
?>
<?php if ($block->isInstallmentWidgetEnabled()) : ?>
    <?php $script = <<<SCRIPT
        // The widget takes the shopper's country from the checkout quote, whose
        // model reads window.checkoutConfig when it loads. This block renders in
        // the head, before that config is printed, so wait for the DOM first.
        require(['domReady!'], function () {
            require(['Sezzle_Sezzlepay/js/installment-widget'], function (initInstallmentWidget) {
                initInstallmentWidget();
            });
        });
    SCRIPT; ?>

    <?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false); ?>
<?php endif; ?>
