<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            One block per placement the merchant can choose; only the one matching the
            "Sezzle Ads Placement" setting renders (see SezzleAds::isConfiguredPlacement()).
            cacheable="false": the config carries the order's Sezzle UUID, which must never reach the full-page cache.
        -->
        <referenceContainer name="main">
            <block class="Sezzle\Sezzlepay\Block\Widget\SezzleAds" name="sezzle.ads.success.main_top" template="Sezzle_Sezzlepay::sezzle_ads.phtml" before="-" cacheable="false">
                <arguments>
                    <argument name="placement" xsi:type="string">main_top</argument>
                </arguments>
            </block>
            <block class="Sezzle\Sezzlepay\Block\Widget\SezzleAds" name="sezzle.ads.success.main_bottom" template="Sezzle_Sezzlepay::sezzle_ads.phtml" after="-" cacheable="false">
                <arguments>
                    <argument name="placement" xsi:type="string">main_bottom</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Sezzle\Sezzlepay\Block\Widget\SezzleAds" name="sezzle.ads.success.after_confirmation" template="Sezzle_Sezzlepay::sezzle_ads.phtml" after="checkout.success" cacheable="false">
                <arguments>
                    <argument name="placement" xsi:type="string">after_confirmation</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
